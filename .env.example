# Шаблон переменных окружения. Скопируй в .env и заполни значения.
# Файл .env коммитить в git НЕЛЬЗЯ (он в .gitignore).

# ─── AmoCRM API ──────────────────────────────────────────────────────
AMOCRM_SUBDOMAIN=your-company
AMOCRM_TOKEN=

# ─── Виджет ────────────────────────────────────────────────────────
# Секрет, зашитый в widget/script.js — сверяется на каждом вызове /api/widget/*.
# Сгенерировать: openssl rand -hex 24
WIDGET_SHARED_SECRET=

# ID списка «Распределение: группы» и его кастомных полей
LEAD_BUTTON_CATALOG_GROUPS_ID=
LEAD_BUTTON_FIELD_GROUP_TAG=
LEAD_BUTTON_FIELD_GROUP_MEMBERS=
LEAD_BUTTON_FIELD_GROUP_ACTIVE=

# ID списка «Распределение: счётчики» и его кастомных полей
LEAD_BUTTON_CATALOG_COUNTERS_ID=
LEAD_BUTTON_FIELD_COUNTER_USER_ID=
LEAD_BUTTON_FIELD_COUNTER_MONTH=
LEAD_BUTTON_FIELD_COUNTER_COUNT=

# ID списка «Распределение: настройки» и его полей. Сама воронка/этап
# источника и назначения сюда НЕ пишутся — настраивается через экран
# настроек виджета в AmoCRM, только ID самого списка+полей.
LEAD_BUTTON_CATALOG_SETTINGS_ID=
LEAD_BUTTON_FIELD_SETTINGS_SOURCE_PIPELINE=
LEAD_BUTTON_FIELD_SETTINGS_SOURCE_STATUS=
LEAD_BUTTON_FIELD_SETTINGS_TARGET_PIPELINE=
LEAD_BUTTON_FIELD_SETTINGS_TARGET_STATUS=
