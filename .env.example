# Шаблон переменных окружения. Скопируй в .env и заполни значения.
# Файл .env коммитить в git НЕЛЬЗЯ (он в .gitignore).

# ─── AmoCRM API ──────────────────────────────────────────────────────
AMOCRM_SUBDOMAIN=your-company
AMOCRM_TOKEN=

# ─── Вход менеджеров через OAuth AmoCRM ────────────────────────────────
# Отдельная интеграция от AMOCRM_TOKEN (AmoCRM → Настройки → Интеграции →
# Создать → Внешняя интеграция; redirect_uri = AMOCRM_OAUTH_REDIRECT_URI ниже).
# Менеджер логинится своим паролем от AmoCRM на стороне AmoCRM — мы его
# пароль не видим, только подтверждённый user_id после входа.
AMOCRM_OAUTH_CLIENT_ID=
AMOCRM_OAUTH_CLIENT_SECRET=
AMOCRM_OAUTH_REDIRECT_URI=https://your-service.onrender.com/oauth/callback

# Ключ для подписи cookie сессии (вход менеджера помнится в браузере).
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ─── HTTP Basic Auth для настроек (владелец/руководители) ─────────────
# Доступ к /settings (группы, лимиты, воронка) — отдельно от входа менеджеров.
LEAD_BUTTON_ADMIN_USER=admin
LEAD_BUTTON_ADMIN_PASS=

# ID списка «Распределение: группы» и его кастомных полей
LEAD_BUTTON_CATALOG_GROUPS_ID=
LEAD_BUTTON_FIELD_GROUP_TAG=
LEAD_BUTTON_FIELD_GROUP_MEMBERS=
LEAD_BUTTON_FIELD_GROUP_ACTIVE=

# ID списка «Распределение: счётчики» и его кастомных полей. Счётчик — по
# (сотрудник × ГРУППА × месяц): менеджер может состоять в нескольких группах
# одновременно, у каждой свой отдельный лимит/остаток.
LEAD_BUTTON_CATALOG_COUNTERS_ID=
LEAD_BUTTON_FIELD_COUNTER_USER_ID=
LEAD_BUTTON_FIELD_COUNTER_GROUP_ID=
LEAD_BUTTON_FIELD_COUNTER_MONTH=
LEAD_BUTTON_FIELD_COUNTER_COUNT=

# ID списка «Распределение: настройки» и его полей. Сама воронка/этап
# источника и назначения сюда НЕ пишутся — настраивается через экран
# настроек виджета в AmoCRM, только ID самого списка+полей.
LEAD_BUTTON_CATALOG_SETTINGS_ID=
LEAD_BUTTON_FIELD_SETTINGS_SOURCE_PIPELINE=
LEAD_BUTTON_FIELD_SETTINGS_SOURCE_STATUS=
LEAD_BUTTON_FIELD_SETTINGS_TARGET_PIPELINE=
LEAD_BUTTON_FIELD_SETTINGS_TARGET_STATUS=
# Необязательно — уточнение источника: брать только сделки, которые сейчас
# висят на конкретном ответственном (обычно техническом/интеграционном
# аккаунте приёма лидов). Настраивается через экран настроек, это лишь ID поля.
LEAD_BUTTON_FIELD_SETTINGS_SOURCE_RESPONSIBLE=
